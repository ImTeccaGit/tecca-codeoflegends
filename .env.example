# Tecca CodeOfLegends — environment template.
# Copy to `.env.local` for local development. Never commit real credentials.

# The Riot API key is intentionally NOT consumed by the frontend.
# Future backend integration must read it from the OS credential store or a
# process-level environment variable that is never exposed to the webview.
# RIOT_API_KEY=...  # DO NOT place a real key in this repository.

# Optional development overrides
# VITE_APP_ENV=development
